{
  "name": "liftcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-linked station access checks and independently checked alternatives",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "data:refresh": "python3 scripts/refresh-data.py",
    "build": "node scripts/build-site.mjs",
    "db:generate": "drizzle-kit generate",
    "test:hosted": "npm run build && node --test tests/hosted/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "wrangler": "^4.141.0",
    "miniflare": "5.20260925.0-alpha"
  }
}
